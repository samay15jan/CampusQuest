# ---- API ----
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed frontend origins. Empty = allow all (dev only).
CORS_ORIGIN=http://localhost:5173

# ---- PostgreSQL (DB_HOST=postgres inside Docker Compose, localhost when running directly) ----
DB_HOST=postgres
DB_PORT=5432
DB_NAME=campusquest
DB_USER=campus
DB_PASSWORD=campus123

# ---- Firebase Admin (service account JSON). Key on ONE line, double-quoted, literal \n ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ---- Admin (portal / riddle / reference-image / event management) ----
# Send as header: x-admin-key. Admin routes are disabled while this is empty.
ADMIN_API_KEY=

# ---- Game clock ----
CAMPUS_TZ=Asia/Kolkata
# Two portal-open windows per day (campus time). Must fall inside 09:00-17:00.
PORTAL_WINDOWS=09:00-12:30,14:00-17:00

# ---- Image verification ----
# mock = always returns MATCHER_MOCK_SIMILARITY (until the image-recognition service exists)
# http = POST to IMAGE_MATCHER_URL (contract in README)
IMAGE_MATCHER=mock
IMAGE_MATCHER_URL=
MATCHER_MOCK_SIMILARITY=0.72
IMAGE_MATCH_THRESHOLD=0.70
# Optional range overrides in metres. Empty = each portal's own radius_m (default 20).
DEPLOY_RANGE_M=
ATTACK_RANGE_M=

# ---- Reference image storage ----
UPLOAD_DIR=./uploads

# ---- DEV ONLY (both are refused/ignored in production) ----
# Accept "Authorization: Bearer dev:<uid>:<email>" instead of a Firebase token.
DEV_AUTH_BYPASS=false
# Skip the Mon-Fri 9-5 + portal-window checks so you can test at night/weekends.
DEV_IGNORE_HOURS=false
